/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mantomart-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"dev": {
		"port": 8002
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "63c4ae3c-6154-4295-8d1b-c656f43f3025",
			"database_name": "mantomart",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "d57d517e0e794865abb06bbf29424889",
			"preview_id": "84e7b1420615455a8f2f431c7b222503"
		}
	],
	/**
	 * R2 bucket for admin image uploads (Worker binding only — no S3 keys).
	 * - Local `wrangler dev` uses preview_bucket_name → .wrangler/state/v3/r2
	 * - Deploy uses bucket_name (real Cloudflare R2)
	 * - Objects are served at GET /api/images/{key} unless R2_PUBLIC_URL is set
	 */
	"r2_buckets": [
		{
			"binding": "R2_IMAGES",
			"bucket_name": "mantomart",
			"preview_bucket_name": "mantomart-dev"
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
}